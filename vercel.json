{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/event/:slug([a-z0-9][a-z0-9\\-]{1,59})",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Twitterbot|facebookexternalhit|WhatsApp|TelegramBot|Slackbot|LinkedInBot|Discordbot|Googlebot|bingbot|Pinterestbot|Applebot).*"
        }
      ],
      "destination": "/api/meta?slug=:slug"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
